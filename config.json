{
  // ===== 渲染（ghost 是唯一渲染路径；粒子渲染已整体移除）=====
  "render": {
    "mode": "ghost",  // 渲染模式：只有 ghost（往世界写真实半透明方块）
    "ghostWritesPerTick": 300,  // 每 tick 最多写多少格 ghost（1 万方块 ≈ 34 tick）
    "ghostMaxBlocks": 60000,  // 单个投影最多写多少格，超限直接拒绝（防写爆存档）
    "ghostOverwriteReplaceable": true,  // 是否覆盖花草/水/雪这类可替换方块（玩家放的永远不覆盖）
    "tickBudgetMs": 8,  // 统一调度器单 tick 给周期任务的总预算（毫秒）
    "enableMega": true  // 超大投影（> megaSchematic.threshold）走 .mcmega 分块存储 + ghost 分块注入
  },

  // ===== 轻松放置 =====
  "easyPlace": {
    "enabled": true,  // 启用轻松放置（判定为 ghost 即视为"空位可放"）

    // 投影打印机：把半径内的 ghost 格自动填成真方块
    "printer": {
      "radius": 5,  // 搜索半径（格）
      "maxPerCycle": 12,  // 每轮（200ms）最多放多少格（调大容易卡服）
      "budgetMs": 6,  // 单轮时间预算（毫秒），超出的格留到下一轮
      "placeDelayMs": 0,  // 大于 0 时每格之间等待的毫秒数（用于控制放置速度）
      "overwriteReplaceable": true,  // 顶掉花草/雪/水；玩家自己放的方块永远不覆盖
      "debug": false  // true = 写 logs/LitematicaBE/easyplace_debug.log（最多 5 秒一条）
    }
  },

  // ===== 投影显示 =====
  "projection": {
    "showBounds": true,  // 显示投影边界框
    "boundsColor": "#00FF00",  // 边界框颜色
    "mirrorX": false,  // 默认镜向 X 轴
    "mirrorZ": false,  // 默认镜向 Z 轴
    "rotation": 0  // 默认旋转角度（0/90/180/270）
  },

  // ===== 日志清理 =====
  "logCleaner": {
    "enabled": true,  // 启用自动清理
    "scanInterval": 60000,  // 扫描间隔（毫秒）
    "backupEnabled": true,  // 清理前备份
    "maxBackupFiles": 10,  // 最多保留备份数
    "patterns": [  // 需要从日志里剔除的渲染噪音
      "litematica:block_",
      "Spawning particle",
      "litematica:.*particle",
      "execute in.*particle",
      "render"
    ]
  },

  // ===== 超大投影（MEGA）加载参数 ====
  // enableMega=false 时只用于判定"是否超过阈值"，超阈值会回退普通加载
  "megaSchematic": {
    "threshold": 30000,  // 超大型投影阈值（方块数）
    "enabled": true,  // 允许超大型投影加载（仍需 render.enableMega 才能真渲染）
    "chunkSize": 32,  // 仅作说明：实际分块大小由 BinaryChunkStorage.CHUNK_SIZE 固定为 32，改这里无效
    "storagePath": "./plugins/LitematicaBE/mega_schematics/"  // 分块存储路径
  },

  // ===== Mega 调试（全量注入模式无可调渲染参数：注入速度跟随 render.ghostWritesPerTick）=====
  "megaRender": {
    "debug": false,  // true = 输出 [MegaRender] 详细调试信息
    "fileDebug": false  // true = 额外写 plugins/LitematicaBE/logs/ 下的注入日志（排查卡住时开）
  }
}

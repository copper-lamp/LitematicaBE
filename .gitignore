# --- 运行时数据 ---
/data/

# --- 导出文件 ---
exports/

# --- 投影数据（用户生成内容） ---
schematics/
mega_schematics/

# --- 测试 ---
# tests/ 已入库：CI 要跑行为回归（npm test）。临时探测脚本仍放 work/（见文件末尾）
tests/.tmp/

# --- 调试文件 ---
debug_*

# --- 依赖 ---
node_modules/

# --- 构建产物 ---
/build/
/dist/

# --- 系统文件 ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE 配置 ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 与发布无关的开发工具（本地开发辅助，不参与 npm run build / Release） ---
/docs/
/work/
/addon/
# tools/ 下除发布构建工具外全部忽略（后期新增开发脚本自动忽略）
/tools/*
!/tools/build-release.mjs
!/tools/check-version.mjs
!/tools/zip.mjs
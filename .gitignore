# --- 运行时数据 ---
/data/

# --- 导出文件 ---
exports/

# --- 投影数据（用户生成内容） ---
schematics/
mega_schematics/

# --- 测试 ---
# tests/ 已入库：CI 要跑行为回归（npm test）。临时探测脚本仍放 work/（见文件末尾）
tests/.tmp/

# --- 调试文件 ---
debug_*

# --- 依赖 ---
node_modules/

# --- 构建产物 ---
/build/
/dist/

# --- 系统文件 ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE 配置 ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 与发布无关的开发工具（本地开发辅助，不参与 npm run build / Release） ---
/docs/
/work/
/addon/
# tools/ 下除发布/校验工具外全部忽略（后期新增开发脚本自动忽略）
# 注意：这里是**白名单**，新增任何被 npm script / CI / 源码引用的 tools 文件都必须加例外；
# 漏加时本地照跑、CI 干净检出 MODULE_NOT_FOUND —— `node tools/check-tracked.mjs` 会拦住。
/tools/*
!/tools/build-release.mjs
!/tools/check-version.mjs
!/tools/check-tracked.mjs
!/tools/zip.mjs
!/tools/sync-version.mjs
# lib/ 是上面几个构建工具的共用依赖（build-release.mjs 用它做贴图半透明自检），必须入库
!/tools/lib/
!/tools/lib/png.js